# Local development only. Copy to .env.local and fill in real values.
# Never commit this file, a service-account JSON key, or any GitHub token.

# ── Google Drive (service account) ────────────────────────────────
# Paste the whole service-account JSON on one line (recommended).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Or use the split form instead:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=portal@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=1IKIdODOiY_0hwanRQ4xk-MhzKVlXVprF

# ── Google Sign-In (optional; also verifies ID tokens) ────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Session signing ───────────────────────────────────────────────
# Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-secret

# ── GitHub (optional for a public repo) ───────────────────────────
GITHUB_REPO=AARDMC/AAPHREML-IRERC
# GITHUB_TOKEN=github_pat_...

# ── Staff accounts (server-side only; no VITE_ prefix) ────────────
# Preferred: one JSON array.
# STAFF_ACCOUNTS=[{"email":"admin@example.org","password":"...","role":"admin","name":"System Administrator"},{"email":"chair@example.org","password":"...","role":"chair"}]
#
# Or the per-role form:
# STAFF_ADMIN_EMAIL=addisrdmc@gmail.com
# STAFF_ADMIN_PASS=YourAdminPassword123
# STAFF_CHAIR_EMAIL=asmamawdeguale16@gmail.com
# STAFF_CHAIR_PASS=YourChairPassword123
# STAFF_SECRETARIAT_EMAIL=alemnigussie971@gmail.com
# STAFF_SECRETARIAT_PASS=YourSecPassword123
